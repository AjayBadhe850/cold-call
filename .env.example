# ==========================================
# Frontend Configuration (.env or Vercel env)
# ==========================================
# In local development, the Vite dev server proxies /api to http://localhost:5000.
# In production on Vercel, set this to your deployed Render backend URL (e.g., https://cold-call-assistant-api.onrender.com).
VITE_API_BASE_URL=http://localhost:5000

# ==========================================
# Backend Configuration (server/.env or Render env)
# ==========================================
PORT=5000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated or single domain)
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Configuration
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# LLM Provider Configuration
# Supported: gemini (Google Gemini free-tier via Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=your-google-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
